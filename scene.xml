<mujoco model="jetracer_figure8_track">
  <!--
    Waveshare JetRacer AI Kit - Professional Figure-8 Race Track & Sim2Real Arena
    Features:
    - Symmetric Figure-8 (Lemniscate) race course with smooth continuous curvature
    - Active crossing intersection with clear throat markers and sightlines
    - 100% VISIBLE Red & White perimeter barrier walls enclosing the entire arena
    - Alternating rumble curbs at high-G corner apexes
    - Infield cylindrical tire/barrier hubs with safe track clearance
    - Dual tracking & birds-eye cameras
    - Self-contained vehicle inclusion via <include file="jetracer.xml"/>
  -->
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" integrator="implicitfast" iterations="50" solver="Newton">
    <flag contact="enable" energy="enable"/>
  </option>

  <default>
    <!-- Visual Markings (group 2, zero mass, non-colliding) -->
    <default class="track_visual">
      <geom group="2" contype="0" conaffinity="0" density="0" mass="0"/>
    </default>
    <!-- Solid & 100% VISIBLE Track Barriers & Cones (group 0 is ALWAYS visible in Studio) -->
    <default class="track_collision">
      <geom group="0" contype="1" conaffinity="1" condim="3" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75" specular="0.25 0.25 0.25"/>
    <map znear="0.0005"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-30" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <!-- Sky & Ground Visuals -->
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.15 0.2"
             width="512" height="512"/>
    <texture name="asphalt_tex" type="2d" builtin="checker" rgb1="0.18 0.18 0.20" rgb2="0.22 0.22 0.24"
             width="512" height="512" mark="none"/>
    <material name="asphalt" texture="asphalt_tex" texrepeat="25 25" reflectance="0.08"
              roughness="0.8" specular="0.1"/>

    <!-- Track Barrier & Obstacle Materials -->
    <material name="barrier_red" rgba="0.88 0.15 0.15 1.0" metallic="0.2" roughness="0.4"/>
    <material name="barrier_white" rgba="0.95 0.95 0.95 1.0" metallic="0.2" roughness="0.4"/>
    <material name="lane_yellow" rgba="0.95 0.82 0.10 1.0" reflectance="0.1"/>
    <material name="lane_white" rgba="0.95 0.95 0.95 1.0" reflectance="0.1"/>
    <material name="cone_orange" rgba="0.95 0.40 0.05 1.0" metallic="0.1" roughness="0.5"/>
    <material name="curb_red" rgba="0.85 0.15 0.15 1.0" reflectance="0.1"/>
    <material name="curb_white" rgba="0.92 0.92 0.92 1.0" reflectance="0.1"/>
  </asset>

  <worldbody>
    <!-- Sunlight and Ambience -->
    <light directional="true" pos="0 0 10" dir="0.2 0.3 -1" diffuse="0.85 0.85 0.85" specular="0.35 0.35 0.35" castshadow="true"/>
    <light directional="true" pos="-5 -5 6" dir="-0.5 -0.5 -0.7" diffuse="0.35 0.35 0.40" specular="0.1 0.1 0.1" castshadow="false"/>

    <!-- Ground Track Plane (Level surface at z=0) -->
    <geom name="track_ground" type="plane" size="25 25 0.1" material="asphalt"
          condim="4" friction="1.0 0.01 0.002" solref="0.004 1" solimp="0.95 0.99 0.001"/>

    <!-- Overview Tracking Cameras -->
    <camera name="track_overview" pos="0 -7.5 6.0" xyaxes="1 0 0 0 0.6 0.8"/>
    <camera name="track_birds_eye" pos="0 0 10.5" xyaxes="1 0 0 0 1 0"/>
    <camera name="intersection_cam" pos="0 0 3.5" xyaxes="1 0 0 0 0.4 0.9"/>
    <camera name="car_chase_cam" mode="trackcom" target="jetracer" pos="-1.2 0 0.5" xyaxes="0 -1 0 0.35 0 0.94"/>

    <!-- ============================================================ -->
    <!-- 1. VISIBLE ARENA PERIMETER BARRIER WALLS (100% VISIBLE)      -->
    <!-- ============================================================ -->
    <!-- North Wall (+X = +8.0m) -->
    <geom name="wall_north_1" class="track_collision" type="box" pos="8.0 3.0 0.20" size="0.20 3.0 0.20" material="barrier_red"/>
    <geom name="wall_north_2" class="track_collision" type="box" pos="8.0 -3.0 0.20" size="0.20 3.0 0.20" material="barrier_white"/>
    
    <!-- South Wall (-X = -8.0m) -->
    <geom name="wall_south_1" class="track_collision" type="box" pos="-8.0 3.0 0.20" size="0.20 3.0 0.20" material="barrier_white"/>
    <geom name="wall_south_2" class="track_collision" type="box" pos="-8.0 -3.0 0.20" size="0.20 3.0 0.20" material="barrier_red"/>

    <!-- East Wall (+Y = +6.0m) -->
    <geom name="wall_east_1" class="track_collision" type="box" pos="4.0 6.0 0.20" size="4.0 0.20 0.20" material="barrier_white"/>
    <geom name="wall_east_2" class="track_collision" type="box" pos="-4.0 6.0 0.20" size="4.0 0.20 0.20" material="barrier_red"/>

    <!-- West Wall (-Y = -6.0m) -->
    <geom name="wall_west_1" class="track_collision" type="box" pos="4.0 -6.0 0.20" size="4.0 0.20 0.20" material="barrier_red"/>
    <geom name="wall_west_2" class="track_collision" type="box" pos="-4.0 -6.0 0.20" size="4.0 0.20 0.20" material="barrier_white"/>

    <!-- Corner Chamfers -->
    <geom name="wall_ne" class="track_collision" type="box" pos="6.6 4.6 0.20" size="1.8 0.20 0.20"
          quat="0.9239 0 0 0.3827" material="barrier_red"/>
    <geom name="wall_nw" class="track_collision" type="box" pos="6.6 -4.6 0.20" size="1.8 0.20 0.20"
          quat="0.9239 0 0 -0.3827" material="barrier_white"/>
    <geom name="wall_se" class="track_collision" type="box" pos="-6.6 4.6 0.20" size="1.8 0.20 0.20"
          quat="0.9239 0 0 -0.3827" material="barrier_white"/>
    <geom name="wall_sw" class="track_collision" type="box" pos="-6.6 -4.6 0.20" size="1.8 0.20 0.20"
          quat="0.9239 0 0 0.3827" material="barrier_red"/>

    <!-- ============================================================ -->
    <!-- 2. INFIELD BARRIER HUBS & INTERSECTION GUIDE CONES           -->
    <!-- ============================================================ -->
    <!-- Left Loop Infield Barrier Hub (centered at -2.1, 0) -->
    <body name="hub_left" pos="-2.1 0 0">
      <geom name="hub_l_col" class="track_collision" type="cylinder" pos="0 0 0.15" size="0.35 0.15" material="barrier_red"/>
      <geom name="hub_l_top" class="track_visual" type="cylinder" pos="0 0 0.30" size="0.36 0.01" material="barrier_white"/>
    </body>

    <!-- Right Loop Infield Barrier Hub (centered at +2.1, 0) -->
    <body name="hub_right" pos="2.1 0 0">
      <geom name="hub_r_col" class="track_collision" type="cylinder" pos="0 0 0.15" size="0.35 0.15" material="barrier_white"/>
      <geom name="hub_r_top" class="track_visual" type="cylinder" pos="0 0 0.30" size="0.36 0.01" material="barrier_red"/>
    </body>

    <!-- Intersection Corner Guide Cones (Safe clearance outside lane) -->
    <body name="cone_ne" pos="1.4 1.4 0"><geom name="cone_ne_g" class="track_collision" type="cylinder" pos="0 0 0.12" size="0.08 0.12" material="cone_orange"/></body>
    <body name="cone_se" pos="1.4 -1.4 0"><geom name="cone_se_g" class="track_collision" type="cylinder" pos="0 0 0.12" size="0.08 0.12" material="cone_orange"/></body>
    <body name="cone_nw" pos="-1.4 1.4 0"><geom name="cone_nw_g" class="track_collision" type="cylinder" pos="0 0 0.12" size="0.08 0.12" material="cone_orange"/></body>
    <body name="cone_sw" pos="-1.4 -1.4 0"><geom name="cone_sw_g" class="track_collision" type="cylinder" pos="0 0 0.12" size="0.08 0.12" material="cone_orange"/></body>

    <!-- Start / Finish Line at (x=0, y=0) crossing diagonal -->
    <geom name="line_start" class="track_visual" type="box" pos="0 0 0.001" euler="0 0 2.385" size="0.55 0.08 0.001" material="lane_white"/>

